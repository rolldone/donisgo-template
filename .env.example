# Example environment variables for local/dev. Copy to .env and fill values.
# Do NOT commit real secrets.
#
# Dipindahkan dari repo donisgo (SPEC-005 fase 3) — berkas ini milik starter
# aplikasi, bukan library.

# === App / DB ===
APP_NAME=Donisgo
APP_ENV=development
PORT=8080

# App URLs (frontends the app talks to / serves)
APP_URL=http://localhost:3651
ADMIN_URL=http://localhost:5173
FRONT_URL=http://localhost:4321
# Landing page terpisah yang di-proxy plugin `pages` untuk path tak dikenal
# (selain /api, /app, /spa). Kosongkan → fallback ke index.html SPA.
HOMEPAGE_URL=

# Database (GORM)
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db

# === JWT / Auth (recommended single source of truth) ===
# Use AUTH_JWT_SECRET as the canonical secret for the auth plugin.
# Replace with a securely generated 32+ byte value (hex/base64).
AUTH_JWT_SECRET=change_me_to_a_strong_secret

# Legacy/compat envs (optional, consider removing to avoid confusion)
#JWT_SECRET=...           # deprecated, prefer AUTH_JWT_SECRET
#JWT_ACCESS_SECRET=...    # deprecated
#JWT_REFRESH_SECRET=...   # deprecated

# Token lifetimes (seconds)
JWT_ACCESS_EXP_SECONDS=900        # 15 minutes
JWT_REFRESH_EXP_SECONDS=1209600   # 14 days

# === Redis / KeyDB ===
KEYDB_HOST=keydb
KEYDB_PORT=6379
KEYDB_PASS=
KEYDB_DB=0

# === SMTP (for email verification & password reset) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=admin@example.com
SMTP_USE_TLS=true
SMTP_STARTTLS=true

# === Storage (file attachments) ===
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
STORAGE_PUBLIC_URL=http://localhost:8200/assets

# === CORS ===
# Comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4321"

# === Trusted proxies ===
# Comma-separated list of IPs/CIDRs allowed to set X-Forwarded-For / X-Real-IP
# (gin uses them to resolve ClientIP).
# Empty = trust NO proxy: forwarded headers are ignored and ClientIP is the
# socket peer. REQUIRED when running behind a reverse proxy (nginx/caddy/
# traefik/NPM) — otherwise ClientIP() reports the proxy address.
# Invalid entries are ignored with a warning (falls back to trust-none).
# Example: 10.0.0.0/8,172.16.0.5
TRUSTED_PROXIES=

# === Misc ===
LOG_LEVEL=info

# Docker host (use your host or docker machine IP if needed)
DOCKER_HOST_IP=127.0.0.1
